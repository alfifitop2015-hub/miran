rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null; }
    function isAdmin() { return signed() && request.auth.token.email == 'alfifitop2015@gmail.com'; }
    function devPath() { return /databases/$(database)/documents/devices/$(request.auth.uid); }
    function isOwner(sid) { return signed() && (request.auth.uid == sid || (exists(devPath()) && get(devPath()).data.sid == sid)); }

    // ملف الطالب وتقدّمه: للطالب نفسه وللمدير
    function stuPath(sid) { return /databases/$(database)/documents/students/$(sid); }
    function approved(sid) { return get(stuPath(sid)).data.get('status', 'approved') != 'pending'; }
    // ولي الأمر للاطلاع فقط: لا يدخل لوحة الترتيب
    function competitor(sid) { return get(stuPath(sid)).data.get('role', 'student') != 'parent'; }

    // ملف الطالب: يُنشأ بحالة «بانتظار الموافقة»، ولا يستطيع الطالب تغيير حالته بنفسه
    match /students/{sid} {
      allow read, delete: if isOwner(sid);
      allow create: if isOwner(sid) && request.resource.data.status == 'pending';
      allow update: if isOwner(sid)
        && request.resource.data.get('status', 'approved') == resource.data.get('status', 'approved')
        && request.resource.data.get('role', 'student') == resource.data.get('role', 'student');
    }

    // رمز رابط النقل لجهاز آخر
    match /studentSecrets/{sid} {
      allow read, write: if isOwner(sid);
    }

    // ربط جهاز برابط النقل: يُقبل فقط إذا طابق الرمز
    match /devices/{uid} {
      allow read, delete: if signed() && request.auth.uid == uid;
      allow create, update: if signed() && request.auth.uid == uid
        && request.resource.data.pin is string
        && request.resource.data.pin == get(/databases/$(database)/documents/studentSecrets/$(request.resource.data.sid)).data.pin;
    }

    // لوحة الترتيب
    match /players/{id} {
      allow read: if true;
      allow create, update: if isOwner(id) && approved(id) && competitor(id)
        && request.resource.data.sid == id
        && request.resource.data.nick is string
        && request.resource.data.nick.size() > 0
        && request.resource.data.nick.size() <= 20
        && request.resource.data.grade is int
        && request.resource.data.total is int
        && request.resource.data.total >= 0;
      allow delete: if isOwner(id);
    }

    // منافسة «ني هاو» (الصينية): التسجيل بالاسم، والانضمام بموافقة المدير
    // «ني هاو»: الدخول من جهاز آخر برابط ورمز سري
    function zhDev() { return /databases/$(database)/documents/zhDevices/$(request.auth.uid); }
    function isZh(sid) { return signed() && (request.auth.uid == sid || (exists(zhDev()) && get(zhDev()).data.sid == sid)); }
    // الرقم السري: يختاره صاحبه مرة واحدة (4 أرقام)، وتغييره للمشرف فقط
    match /zhSecrets/{sid} {
      allow read: if isZh(sid);
      allow create: if isZh(sid) && request.resource.data.pin is string && request.resource.data.pin.matches('^[0-9]{4}$');
      allow update: if isZh(sid) && request.resource.data.pin is string && request.resource.data.pin.matches('^[0-9]{4}$')
        && !(resource.data.pin is string && resource.data.pin.matches('^[0-9]{4}$'));
    }
    match /zhDevices/{uid} {
      allow read, delete: if signed() && request.auth.uid == uid;
      allow create, update: if signed() && request.auth.uid == uid
        && request.resource.data.pin is string
        && request.resource.data.pin == get(/databases/$(database)/documents/zhSecrets/$(request.resource.data.sid)).data.pin;
    }
    match /zhPlayers/{uid} {
      allow read: if signed() && (isZh(uid) || resource.data.status == 'approved');
      allow create: if signed() && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.total == 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.gender in ['m', 'f'];
      allow update: if isZh(uid)
        && request.resource.data.status == resource.data.status
        && request.resource.data.name == resource.data.name
        && request.resource.data.gender == resource.data.gender
        && request.resource.data.total is int
        && request.resource.data.total >= resource.data.total
        && (resource.data.status == 'approved' || request.resource.data.total == resource.data.total);
    }

    // مدير النظام: صلاحية كاملة على كل البيانات
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
